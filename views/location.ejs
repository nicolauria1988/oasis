<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oasis</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('header.ejs') %>
    <div class="px-10 py-5">
      <div class="grid gap-4 max-w-3xl mx-auto">
        <div class="flex justify-between items-center mt-5">
          <div>
            <h3 class="text-xl font-bold"><%= location.street %></h3>
            <p class="text-sm"><%= `${location.city}, ${location.state}` %></p>
          </div>
          <div>
            <h4 class="text-lg" id="price" data-price="<%= location.price %>">
              <%= `${location.price} per night` %>
            </h4>
            <p class="text-sm">4.7 (100 reviews)</p>
          </div>
        </div>
        <div>
          <img
            src="../images/<%= location.images[0] %>"
            class="w-full rounded-lg h-65 sm:h-100"
            id="main-image"
          />
        </div>
        <div class="grid grid-cols-5 gap-4">
          <div>
            <img
              src="../images/<%= location.images[0] %>"
              class="max-w-full rounded-lg h-[50px] sm:h-[100px] image-thumbnail cursor-pointer"
            />
          </div>
          <div>
            <img
              src="../images/<%= location.images[1] %>"
              class="max-w-full rounded-lg h-[50px] sm:h-[100px] image-thumbnail cursor-pointer"
            />
          </div>
          <div>
            <img
              src="../images/<%= location.images[2] %>"
              class="max-w-full rounded-lg h-[50px] sm:h-[100px] image-thumbnail cursor-pointer"
            />
          </div>
          <div>
            <img
              src="../images/<%= location.images[3] %>"
              class="max-w-full rounded-lg h-[50px] sm:h-[100px] image-thumbnail cursor-pointer"
            />
          </div>
          <div>
            <img
              src="../images/<%= location.images[4] %>"
              class="max-w-full rounded-lg h-[50px] sm:h-[100px] image-thumbnail cursor-pointer"
            />
          </div>
        </div>
      </div>

      <div class="flex justify-center items-center mt-5 mb-5">
        <div
          class="max-w-3xl divide-y divide-gray-200 rounded-lg bg-white shadow-sm mt-5"
        >
          <div
            class="flex justify-between items-center gap-5 px-4 py-5 sm:px-6"
          >
            <div class="flex items-center gap-5">
              <img
                src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
                alt=""
                class="inline-block size-14 rounded-full"
              />
              <div>
                <h2 class="text-xl font-bold">Edward Jones</h2>
                <p>Hosting since 1/1/2020</p>
              </div>
            </div>
          </div>
          <div class="px-4 py-5 sm:p-6">
            <p class="text-lg/7"><%= location.notes %></p>
          </div>
        </div>
      </div>
      <% if (!user) { %>
      <p
        class="max-w-3xl mx-auto mb-5 p-5 outline-1 outline-gray-300 text-center"
      >
        Booking calendar not displayed because you are not signed in.
      </p>
      <% } else if (user._id == location.user._id.toString()) { %>
      <p
        class="max-w-3xl mx-auto mb-5 p-5 outline-1 outline-gray-300 text-center"
      >
        Booking calendar not displayed because you own this property.
      </p>
      <% } else { %>
      <div
        id="calendar"
        data-availableDates="<%= JSON.stringify(location.availableDates || []) %>"
        class="mt-5 mb-5 max-w-3xl mx-auto"
      ></div>
      <div id="added-date"></div>
      <% } %>
    </div>
    <script src="/js/header.js"></script>
    <script>
      const userId = "<%= user._id %>";
      const locationId = "<%= location._id %>";
    </script>
    <script>
      const csrfToken = "<%= csrfToken %>";
    </script>
    <script src="/js/location.js"></script>
  </body>
</html>
