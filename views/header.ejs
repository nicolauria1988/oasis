<header
  class="h-[100px] border-b-1 border-gray-100 mx-auto max-w-7xl p-5 grid grid-cols-[1fr_3fr_1fr] items-center"
>
  <a href="/">
    <img src="/images/oasis-logo.png" class="w-15" />
  </a>
  <input
    type="search"
    name="search"
    placeholder="Search"
    class="w-3/4 justify-self-center p-3 outline-1 outline-gray-300"
  />
  <% if (user && user.avatar) { %>
  <img
    src="../images/<%= user.avatar %>"
    id="user-menu-button"
    class="size-8 rounded-full cursor-pointer justify-self-end"
  />
  <% } else { %>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    class="size-8 cursor-pointer justify-self-end"
    id="user-menu-button"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
    />
  </svg>
  <% } %>
</header>

<div
  id="user-menu"
  class="hide absolute top-0 right-0 h-screen w-screen overflow-hidden sm:top-20 sm:right-[5%] sm:size-40 z-2 flex flex-col justify-center items-center gap-5 sm:gap-1 bg-gray-100"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
    id="mobile-menu-close"
    class="size-6 absolute top-5 left-5 sm:hidden"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M6 18 18 6M6 6l12 12"
    />
  </svg>
  <% if (user) { %>

  <a href="/account" class="mb-5 hover:text-[var(--color-primary)]">Account</a>

  <form action="/logout" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button
      type="submit"
      class="cursor-pointer hover:text-[var(--color-primary)]"
    >
      Logout
    </button>
  </form>

  <% } else { %>

  <a href="/register" class="mb-5 hover:text-[var(--color-primary)]"
    >Register</a
  >

  <a href="/login" class="hover:text-[var(--color-primary)]">Login</a>

  <% } %>
</div>
