<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oasis</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('header.ejs', { user: locals.user }) %>

    <div class="p-10">
      <h2 class="text-xl mb-5">Profile</h2>
      <div class="overflow-x-scroll">
        <table class="min-w-full divide-y divide-solid divide-gray-300 mb-5">
          <thead>
            <tr class="border-b-3 border-gray-300">
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Email
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Name
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Phone
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Street
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                City
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Zip Code
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                State
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Country
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-solid divide-gray-200">
            <tr>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.email %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.name %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.phone %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.street %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.city %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.zipCode %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.state %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= user.country %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-right text-sm font-semibold text-primary"
              >
                <a href="/user/<%= user._id %>/edit">Edit</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2 class="text-xl mt-5 mb-5">Locations</h2>

      <div class="overflow-x-scroll">
        <table class="min-w-full divide-y divide-solid divide-gray-300 mb-5">
          <thead>
            <tr class="border-b-3 border-gray-300">
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Street
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                City
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Zip Code
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                State
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Country
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Price
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Rating
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-right text-sm font-semibold text-primary"
              >
                <a href="/location/new">Add New</a>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-solid divide-gray-200">
            <% locations.forEach(location => { %>
            <tr>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.street %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.city %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.zipCode %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.state %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.country %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.price %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                4.7 (100 reviews)
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-right text-sm font-semibold text-primary"
              >
                <a href="/location/<%= location._id %>/availability"
                  >Availability</a
                >
                |
                <a href="/location/<%= location._id %>/edit">Edit</a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <h2 class="text-xl mt-5 mb-5">Reservations</h2>

      <div class="overflow-x-scroll">
        <table class="min-w-full divide-y divide-solid divide-gray-300 mb-5">
          <thead>
            <tr class="border-b-3 border-gray-300">
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Role
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Street
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                City
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Zip Code
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                State
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Country
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Start Date
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                End Date
              </th>
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Total
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-solid divide-gray-200">
            <% reservations.forEach(reservation => { %>
            <tr>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Guest
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.location.street %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.location.city %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.location.zipCode %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.location.state %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.location.country %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.startDate.toISOString().split('T')[0] %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.endDate.toISOString().split('T')[0] %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.total %>
              </td>
            </tr>
            <% }) %> <% locations.forEach(location => { %> <%
            location.reservations.forEach(reservation => { %>
            <tr>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Host
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.street %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.city %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.zipCode %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.state %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= location.country %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.startDate.toISOString().split('T')[0] %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.endDate.toISOString().split('T')[0] %>
              </td>
              <td
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                <%= reservation.total %>
              </td>
            </tr>
            <% }) %> <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <script src="/js/header.js"></script>
  </body>
</html>
