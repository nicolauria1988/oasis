<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oasis</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include('header.ejs', { user }) %>

    <div class="min-h-[calc(100vh_-_100px)] px-10 py-5">
      <h2 class="text-xl w-full text-start mt-5 sm:mt-0 mb-5">Edit Profile</h2>
      <form
        action="/user/<%= user._id %>"
        method="POST"
        enctype="multipart/form-data"
        class="w-full"
      >
        <input type="hidden" name="_method" value="PUT" />
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div
          class="flex flex-col flex-wrap sm:flex-row justify-center items-center gap-5"
        >
          <input
            type="email"
            name="email"
            value="<%= user.email %>"
            placeholder="Email"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="password"
            name="password"
            placeholder="Password"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="name"
            value="<%= user.name %>"
            placeholder="Name"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="phone"
            value="<%= user.phone %>"
            placeholder="Phone"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="street"
            value="<%= user.street %>"
            placeholder="Street"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="city"
            value="<%= user.city %>"
            placeholder="City"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="state"
            value="<%= user.state %>"
            placeholder="State"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="zipCode"
            value="<%= user.zipCode %>"
            placeholder="Zip Code"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="text"
            name="country"
            value="<%= user.country %>"
            placeholder="Country"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
            required
          />
          <input
            type="file"
            name="image"
            value="<%= user.avatar %>"
            class="w-full block p-3 outline-1 outline-gray-300 basis-[calc(100%-10px)] sm:basis-[calc(50%-10px)]"
          />

          <input
            type="submit"
            value="Submit"
            class="mb-5 sm:mb-0 w-full block p-3 outline-1 outline-gray-300 cursor-pointer"
          />
        </div>
      </form>
    </div>

    <script src="/js/header.js"></script>
  </body>
</html>
